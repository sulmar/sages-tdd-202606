@page "/checkout"
@rendermode InteractiveServer

<PageTitle>Koszyk</PageTitle>

<h1>Koszyk</h1>

<form data-testid="checkout-form" @onsubmit="PlaceOrder" @onsubmit:preventDefault="true">
    <label for="quantity">Ilość</label>
    <input id="quantity" type="number" @bind="Quantity" data-testid="quantity" />

    <button type="submit" data-testid="place-order">Złóż zamówienie</button>
</form>

@code {
    [SupplyParameterFromQuery]
    public int ProductId { get; set; } = 1;

    private int Quantity { get; set; } = 1;

    private void PlaceOrder()
    {
        throw new NotImplementedException();
    }
}
